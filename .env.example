# Optional: enables LLM-polished replies and LLM-generated grounded answers.
# Without it, the app runs fully on the rule engine + TF-IDF retrieval.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works (e.g. a local Ollama/LM Studio server)
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# SQLite file for tickets + uploaded documents
TICKETS_DB=data/tickets.db
